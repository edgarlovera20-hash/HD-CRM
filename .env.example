# HD-CRM Environment Template
# Copy to .env and fill in real values. Never commit .env to version control.

NODE_ENV=development
APP_NAME=HD-CRM
APP_PORT=3001
PORT=3002
API_BASE_URL=http://localhost:3001

# HD-CORE dependency resolution (local | registry)
HD_CORE_MODE=local

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hdcrm
AUDIT_DB_URL=postgresql://user:password@localhost:5432/hdaudit

# Authentication (replace with real secrets in production)
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRY=1h
# Dev-only admin password for local login (never set a real secret here)
DEV_ADMIN_PASSWORD=admin123

# n8n Automation
N8N_WEBHOOK_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=dev-n8n-secret

# Cross-platform event forwarding (producers send to subscriber ingest endpoints)
EVENT_BUS_SECRET=replace-with-a-strong-secret
BRAIN_EVENTS_URL=http://localhost:3003/api/events/ingest

# Logging
LOG_LEVEL=info
